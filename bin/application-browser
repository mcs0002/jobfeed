#!/usr/bin/env python3
"""Stable absolute-path entry point for applications.browser.

The M1 keepalive and the launcher call this file by absolute path.
"""
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.realpath(__file__))))

from applications.browser import main  # noqa: E402

raise SystemExit(main())
